---
import Layout from '../layouts/Layout.astro'
import Mascot from '../components/Mascot.astro'
---

<Layout title="Page not found · OpenKumi" noindex>
  <section class="container lost">
    <Mascot id="lost" look={{ creature: 'blob', color: 'cloud', hat: 'none', extra: 'glasses', clothes: 'purple' }} emoji="🧭" live class="lost-mascot" />
    <h1>This page wandered off.</h1>
    <p>Even the crew could not find it. Let’s get you back.</p>
    <a class="button primary" href="/">Back to OpenKumi</a>
  </section>
</Layout>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: 96px 16px 128px;
    text-align: center;
  }
  .lost :global(.lost-mascot) {
    width: 160px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 56px);
  }
  p {
    color: var(--muted);
    font-size: 19px;
    margin-bottom: 8px;
  }
</style>
