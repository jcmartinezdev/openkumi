---
import type { Look } from '@openkumi/shared'
import Layout from '../layouts/Layout.astro'
import Mascot from '../components/Mascot.astro'
import ProviderMark from '../components/ProviderMark.astro'
import Shot from '../components/Shot.astro'
import { DOWNLOAD_URL, GITHUB_URL } from '../lib/site'

// The superpowers that ship with the app, read from the server's own folder of them, by name as the app lists them.
const powers = Object.entries(import.meta.glob<{ name: string; tagline: string }>('../../../server/superpowers/*/superpower.json', { eager: true, import: 'default' }))
const icons = import.meta.glob<string>('../../../server/superpowers/*/icon.svg', { eager: true, query: '?raw', import: 'default' })
const superpowers = powers
  .map(([file, power]) => ({ ...power, icon: icons[file.replace('superpower.json', 'icon.svg')] }))
  .sort((a, b) => a.name.toLowerCase().localeCompare(b.name.toLowerCase()))

// The first five are the bots in the screenshots, dressed the same.
const crew: { name: string; role: string; look?: Look; emoji?: string }[] = [
  { name: 'Assistant', role: 'Everyday questions, first stop for anything new' },
  { name: 'Researcher', role: 'Reads widely, answers with sources', look: { creature: 'cat', color: 'periwinkle', hat: 'grad', extra: 'glasses', clothes: 'navy' }, emoji: '🔬' },
  { name: 'Inbox', role: 'Sorts mail, drafts the replies', look: { creature: 'bunny', color: 'lemon', hat: 'cap', extra: 'none', clothes: 'teal' }, emoji: '📬' },
  { name: 'Chef', role: 'Plans the week’s meals and the shopping', look: { creature: 'blob', color: 'tangerine', hat: 'chef', extra: 'bowtie', clothes: 'red' }, emoji: '🍳' },
  { name: 'Travel', role: 'Finds flights, keeps the itinerary', look: { creature: 'bug', color: 'mint', hat: 'beanie', extra: 'scarf', clothes: 'purple' }, emoji: '✈️' },
  { name: 'Money', role: 'Watches bills and subscriptions', look: { creature: 'bug', color: 'lemon', hat: 'top', extra: 'bowtie', clothes: 'charcoal' }, emoji: '💰' },
  { name: 'Coach', role: 'Keeps the training plan honest', look: { creature: 'bunny', color: 'berry', hat: 'headband', extra: 'none', clothes: 'teal' }, emoji: '🏃' },
  { name: 'Ideas', role: 'Brainstorms, then hands off the work', look: { creature: 'blob', color: 'periwinkle', hat: 'wizard', extra: 'none', clothes: 'purple' }, emoji: '🧠' },
]

const providers = [
  { id: 'claude-code', name: 'Claude Code', plan: 'your Claude plan' },
  { id: 'codex', name: 'Codex', plan: 'your ChatGPT plan' },
  { id: 'grok', name: 'Grok', plan: 'your Grok plan' },
  { id: 'local', detail: 'Ollama', name: 'Ollama', plan: 'free, on your computer' },
  { id: 'local', name: 'LM Studio', plan: 'free, on your computer' },
  { id: 'openai-compatible', name: 'Any OpenAI-compatible API', plan: 'OpenRouter, OpenAI and more' },
]

const faq = [
  {
    q: 'Is OpenKumi free?',
    a: 'Yes. OpenKumi is open source under the MIT License. Your bots run on a subscription you already have (Claude, ChatGPT or Grok), on free local models, or on any OpenAI-compatible API you choose.',
  },
  {
    q: 'Do I need an API key?',
    a: 'No. If Claude Code, Codex or Grok is installed and signed in on the computer, OpenKumi uses it, and Settings shows what is connected. Local models through Ollama or LM Studio are found on their own. An API key only comes in if you want to use an OpenAI-compatible endpoint.',
  },
  {
    q: 'Where does my data live?',
    a: 'On the computer that runs your bots, in plain files and a database in ~/.openkumi. There is no OpenKumi account and no OpenKumi cloud. What you say to a bot goes to the model provider that bot runs on, and nowhere else.',
  },
  {
    q: 'Could a bot do something I did not want?',
    a: 'A bot has only the superpowers you switch on for it, and cannot change them or give itself more. Each superpower asks before the things you would want to approve. When a bot edits its own instructions, you see the change and can undo it.',
  },
  {
    q: 'What do I need to run it?',
    a: 'A Mac with Google Chrome (each bot browses in a Chrome profile of its own), plus something for the bots to run on: Claude Code, Codex or Grok signed in, Ollama or LM Studio running, or an OpenAI-compatible API. The same code builds for Windows and Linux.',
  },
  {
    q: 'Can I use it from my phone or another computer?',
    a: 'Yes. Bots can run on a computer of yours that stays on, and your laptop or iPhone pairs with it using a one-time code. At home they connect directly; away from home, over Tailscale.',
  },
]
---

<Layout>
  <!-- ---- hero -->
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="pill"><span class="dot"></span>Open source · Runs on your computer</span>
      <h1>Your own crew<br />of AI bots.</h1>
      <p class="lede">
        OpenKumi is a desktop app for AI bots that live on your computer. Each one has its own memory, its own browser that stays signed in, and only the powers you give it. They run on the Claude, ChatGPT or Grok plan you already have.
      </p>
      <div class="ctas">
        <a class="button primary" href={DOWNLOAD_URL}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9s-2-.9-3.4-.9c-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8 2.3-1.3 3.1-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1-2.8-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.4-.6 3.1-1.5z"></path></svg>
          Download for Mac
        </a>
        <a class="button secondary" href={GITHUB_URL}>View on GitHub</a>
      </div>
      <p class="fine">Free and MIT-licensed. No API key, no account.</p>
    </div>
    <div class="container stage">
      <div class="lineup" aria-hidden="true">
        {crew.slice(1, 5).map((bot, i) => <Mascot id={`hero-${i}`} look={bot.look} emoji={bot.emoji} live delay={i * 0.9} class="stand" />)}
      </div>
      <Shot name="conversation" eager alt="The OpenKumi window: a sidebar of bots, each shown by its mascot's head, and a conversation with one of them." />
    </div>
  </section>

  <!-- ---- what it runs on -->
  <section class="runs" aria-labelledby="runs-title">
    <div class="container">
      <h2 id="runs-title" class="runs-title">Runs on the subscription you already pay for</h2>
      <ul class="providers">
        {
          providers.map((p) => (
            <li>
              <ProviderMark id={p.id} detail={p.detail} />
              <span>
                <strong>{p.name}</strong>
                <small>{p.plan}</small>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---- features -->
  <section id="features" class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What a bot gets</span>
        <h2>Less like a chat window. More like a colleague.</h2>
        <p>Every bot is someone with a job, a memory and tools of its own. You decide what it can do; it gets better at doing it.</p>
      </div>

      <div class="feature">
        <div class="copy">
          <h3>One bot, one conversation</h3>
          <p>A bot is someone you talk to, not a pile of chats. Whatever you say lands in the same conversation, and the bot can look up anything said in it, however long ago. Want a clean page? Start fresh, and the conversation so far is kept to read, search or pick up again.</p>
        </div>
        <div class="art sidebar-art" aria-hidden="true">
          {
            crew.slice(0, 4).map((bot, i) => (
              <div class:list={['row', { on: i === 1 }]}>
                <Mascot id={`side-${i}`} look={bot.look} emoji={bot.emoji} crop="fit" class="head" />
                <span>
                  <strong>{bot.name}</strong>
                  <small>{['Booked: Lisbon, 14–18 May', 'Here is the comparison you asked for…', '3 drafts are waiting in Gmail', 'Shopping list is in your Notes'][i]}</small>
                </span>
                {i === 1 && <span class="badge">Working</span>}
              </div>
            ))
          }
        </div>
      </div>

      <div class="feature flip">
        <div class="copy">
          <h3>A browser of its own, already signed in</h3>
          <p>Every bot gets its own Chrome profile. Sign in to a site once and that bot stays signed in, with nothing shared between bots or with your own browser. Watch it work in a live view, take control whenever you like, and hand it back when you are done. If it meets a sign-in page or a CAPTCHA, it asks you and waits.</p>
        </div>
        <div class="art browser-art" aria-hidden="true">
          <div class="browser">
            <div class="chrome"><span></span><span></span><span></span><div class="url">flights.example.com/results</div></div>
            <div class="page">
              <div class="skel w60"></div>
              <div class="flight"><b>LIS</b><i></i><b>AMS</b><em>€ 118</em></div>
              <div class="flight on"><b>LIS</b><i></i><b>AMS</b><em>€ 96</em></div>
              <div class="flight"><b>LIS</b><i></i><b>AMS</b><em>€ 141</em></div>
              <div class="cursor"></div>
            </div>
            <div class="control"><span class="live-dot"></span>Travel is browsing<button tabindex="-1">Take control</button></div>
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="copy">
          <h3>Big jobs, split into subagents</h3>
          <p>A bot can hand parts of a task to subagents that work in parallel, each in its own thread. Watch them live, open one to read or nudge it, or stop it. When they finish, the results flow back to the bot that asked.</p>
        </div>
        <div class="art subagents-art" aria-hidden="true">
          <div class="task">Compare three standing desks under €600</div>
          {
            [
              ['Read reviews of the Flexispot E7', 'done', 'Finished · 41s'],
              ['Check prices and delivery in Portugal', 'done', 'Finished · 1m 12s'],
              ['Look for known problems on forums', 'run', 'Reading 4 of 9 threads'],
            ].map(([title, state, note]) => (
              <div class:list={['sub', state]}>
                <span class="state" />
                <span>
                  <strong>{title}</strong>
                  <small>{note}</small>
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="feature flip">
        <div class="copy">
          <h3>It learns how you like things done, in the open</h3>
          <p>Each bot keeps its own instructions and a memory folder, and rewrites them as it learns how you want it to work. Every change it makes to itself is recorded and shown to you, and any of them can be undone.</p>
        </div>
        <div class="art diff-art" aria-hidden="true">
          <div class="diff-head"><Mascot id="diff" look={crew[1].look} emoji={crew[1].emoji} crop="fit" class="head" /><span><strong>Researcher</strong> updated <code>AGENTS.md</code></span><button tabindex="-1">Undo</button></div>
          <pre><span class="ctx">## How to answer</span>
<span class="add">+ Lead with the recommendation, then the table.</span>
<span class="add">+ Prices in euros, delivery to Portugal.</span>
<span class="del">- Give a detailed summary of every source.</span>
<span class="add">+ Link sources at the end, at most five.</span></pre>
        </div>
      </div>

      <div class="grid3">
        <div class="mini">
          <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <h3>Works while you are away</h3>
          <p>Ask for something every weekday at eight, or once next Friday. It runs in the background and reports back in the bot’s conversation.</p>
        </div>
        <div class="mini">
          <span class="icon"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 15l4-4 3 3 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <h3>Answers you can look at</h3>
          <p>Code in colour, tables, diagrams and formulas. A bot can also show a whole page in the conversation: a chart, a dashboard, a timeline.</p>
        </div>
        <div class="mini">
          <span class="icon"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <h3>A team that knows itself</h3>
          <p>Every bot follows one set of principles, yours to change, and knows who the others are, so it hands a task to the one it fits. Need a new one? Just ask in chat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- superpowers -->
  <section id="superpowers" class="section powers-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Superpowers</span>
        <h2>Powers you hand out, one bot at a time</h2>
        <p>Let a bot work in your apps, or give it know-how: the weather, exchange rates, watching a page, marketing. Each superpower says exactly what it can do, and the ones that work in an app sign in with an account of the bot’s own. A bot can use what you give it, and never give itself more.</p>
      </div>
      <ul class="powers">
        {
          superpowers.map((power) => (
            <li>
              {power.icon ? <img src={`data:image/svg+xml;charset=utf-8,${encodeURIComponent(power.icon)}`} alt="" width="36" height="36" /> : <span class="letter">{power.name[0]}</span>}
              <strong>{power.name}</strong>
              <small>{power.tagline}</small>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---- mascots -->
  <section class="section crew-section" aria-labelledby="crew-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The crew</span>
        <h2 id="crew-title">Everyone on the crew gets a face</h2>
        <p>Every bot is a little jelly creature holding a sign with its emoji. Pick its creature, colour, hat and clothes, or let a new bot dress itself from its name and what it is for.</p>
      </div>
      <ul class="crew">
        {
          crew.map((bot, i) => (
            <li>
              <Mascot id={`crew-${i}`} look={bot.look} emoji={bot.emoji} live delay={(i * 1.3) % 4} class="crew-mascot" />
              <strong>{bot.name}</strong>
              <small>{bot.role}</small>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---- the app itself -->
  <section class="section look-section" aria-labelledby="look-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">A closer look</span>
        <h2 id="look-title">The real thing</h2>
        <p>Straight from the app, in your system’s light or dark.</p>
      </div>
      <div class="gallery">
        <Shot name="browser" sizes="(max-width: 860px) 100vw, 570px" caption="A bot browsing, with its live view floating over the chat." alt="OpenKumi's Travel bot reading a travel guide, with a small live view of its browser in the corner of the window." />
        <Shot name="bot-settings" sizes="(max-width: 860px) 100vw, 570px" caption="Choosing a bot's look, or letting it pick for itself." alt="A bot's settings in OpenKumi: its name, what it is for, and the editor for its mascot's look." />
        <Shot name="superpowers" sizes="(max-width: 860px) 100vw, 570px" caption="Superpowers, switched on for one bot at a time." alt="A bot's superpowers in OpenKumi: some signed in, others ready to activate." />
        <Shot name="tasks" sizes="(max-width: 860px) 100vw, 570px" caption="Scheduled tasks that run in the background and report back." alt="OpenKumi's scheduled tasks: a weekday morning briefing and a weekly dinner plan." />
      </div>
    </div>
  </section>

  <!-- ---- a bot is a folder -->
  <section id="privacy" class="section">
    <div class="container split">
      <div class="copy">
        <span class="eyebrow">Yours, on your computer</span>
        <h2>A bot is a folder you can open</h2>
        <p>What a bot can do is yours to decide: its model, its rules and its superpowers sit where only you can change them. What it knows is its own, kept as plain files it writes itself, with a history you can undo.</p>
        <ul class="checks">
          <li>No OpenKumi account and no OpenKumi cloud. Everything lives in <code>~/.openkumi</code>.</li>
          <li>What you say to a bot goes only to the model provider it runs on.</li>
          <li>Logins stay in the bot’s private folder, where even the bot cannot read them.</li>
        </ul>
      </div>
      <div class="tree" aria-label="The folder of a bot called Researcher">
        <div class="tree-title"><span></span><span></span><span></span>~/.openkumi/bots/researcher</div>
        <pre><span class="you">bot.md</span>              <i>yours: name, model, rules</i>
<span class="you">superpowers.json</span>    <i>yours: what it may use</i>
<b>workspace/</b>          <i>its own</i>
├── <span class="its">AGENTS.md</span>       <i>how it works, in its words</i>
├── <b>memory/</b>         <i>what it has learned</i>
└── <b>files/</b>          <i>what it made for you</i>
<b>private/</b>            <i>its browser and logins</i></pre>
      </div>
    </div>
  </section>

  <!-- ---- everywhere -->
  <section class="section everywhere">
    <div class="container split flip">
      <div class="copy">
        <span class="eyebrow">Wherever you are</span>
        <h2>On this Mac, a computer at home, or your phone</h2>
        <p>Bots run on this Mac, or on another computer of yours that stays on. Pair a laptop or an iPhone with a one-time code that both sides check and that never crosses the network. At home they connect directly; away from home, over Tailscale.</p>
        <p>The iPhone app lets you chat with your bots, watch and steer their browsers, and look after their settings and scheduled tasks.</p>
      </div>
      <div class="devices" aria-hidden="true">
        <div class="mac">
          <span class="label">Mac mini at home</span>
          <div class="heads">
            {crew.slice(0, 5).map((bot, i) => <Mascot id={`dev-${i}`} look={bot.look} emoji={bot.emoji} crop="fit" class="head" />)}
          </div>
          <span class="status"><span class="live-dot"></span>5 bots running</span>
          <ul class="paired">
            <li><span>MacBook Air</span><small>home network</small></li>
            <li><span>iPhone</span><small>Tailscale</small></li>
          </ul>
        </div>
        <div class="phone">
          <div class="notch"></div>
          <div class="bubble me">Anything urgent in my inbox?</div>
          <div class="bubble bot">Two things: the landlord wants a time for the repair, and your flight moved to 9:40. I drafted a reply to the landlord.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- faq -->
  <section id="faq" class="section faq-section">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Good to know</h2>
      </div>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---- end -->
  <section class="end">
    <div class="container end-inner">
      <Mascot id="end" live class="end-mascot" />
      <h2>Meet your crew.</h2>
      <p>Free, open source, and running on your own computer in a few minutes.</p>
      <div class="ctas">
        <a class="button primary" href={DOWNLOAD_URL}>Download for Mac</a>
        <a class="button secondary" href={GITHUB_URL}>View on GitHub</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- hero */
  .hero {
    position: relative;
    padding: 88px 0 0;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 900px;
    background:
      radial-gradient(40% 50% at 30% 30%, color-mix(in srgb, var(--sky) 22%, transparent), transparent 70%),
      radial-gradient(35% 45% at 72% 26%, color-mix(in srgb, var(--orange) 16%, transparent), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 24px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-raised) 70%, transparent);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .dot,
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 25%, transparent);
  }
  h1 {
    font-size: clamp(48px, 9vw, 96px);
    letter-spacing: -0.04em;
    line-height: 0.98;
  }
  .lede {
    max-width: 640px;
    font-size: clamp(18px, 2.2vw, 21px);
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .fine {
    font-size: 14px;
    color: var(--faint);
  }
  .stage {
    position: relative;
    margin-top: 88px;
  }
  /* They stand on the window's title bar, clear of its buttons. */
  .lineup {
    position: absolute;
    right: 190px;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 4px;
    transform: translateY(-82%);
  }
  .lineup :global(.stand) {
    width: 92px;
  }
  .lineup :global(.stand:nth-child(2)) {
    width: 104px;
  }
  @media (max-width: 760px) {
    .lineup {
      right: 72px;
      transform: translateY(-78%);
    }
    .lineup :global(.stand) {
      width: 58px;
    }
    .lineup :global(.stand:nth-child(2)) {
      width: 64px;
    }
    .stage {
      margin-top: 64px;
    }
  }

  /* ---- what it runs on */
  .runs {
    padding: 96px 0 24px;
  }
  .runs-title {
    font: 600 15px/1.4 var(--body);
    letter-spacing: 0;
    text-align: center;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .providers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
  }
  .providers li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-raised);
  }
  .providers span {
    display: grid;
    line-height: 1.3;
  }
  .providers strong {
    font-size: 15px;
  }
  .providers small {
    font-size: 13px;
    color: var(--faint);
  }

  /* ---- features */
  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
