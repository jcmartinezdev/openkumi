---
import type { Look } from '@openkumi/shared'
import Layout from '../layouts/Layout.astro'
import Mascot from '../components/Mascot.astro'
import ProviderMark from '../components/ProviderMark.astro'
import Shot from '../components/Shot.astro'
import { DOWNLOADS, DOWNLOAD_URL, FILM, GITHUB_URL, INSTALL_COMMAND, IPHONE_BETA_URL, ISSUES_URL, RELEASES_URL } from '../lib/site'
import { apps, knowHow, superpowers } from '../lib/superpowers'

// The first five are the bots in the screenshots, dressed the same.
const crew: { name: string; role: string; look?: Look; emoji?: string }[] = [
  { name: 'Kumi', role: 'Everyday questions, first stop for anything new' },
  { name: 'Researcher', role: 'Reads widely, answers with sources', look: { creature: 'cat', color: 'periwinkle', hat: 'grad', extra: 'glasses', clothes: 'navy' }, emoji: '🔬' },
  { name: 'Inbox', role: 'Sorts mail, drafts the replies', look: { creature: 'bunny', color: 'lemon', hat: 'cap', extra: 'none', clothes: 'teal' }, emoji: '📬' },
  { name: 'Chef', role: 'Plans the week’s meals and the shopping', look: { creature: 'blob', color: 'tangerine', hat: 'chef', extra: 'bowtie', clothes: 'red' }, emoji: '🍳' },
  { name: 'Travel', role: 'Finds flights, keeps the itinerary', look: { creature: 'bug', color: 'mint', hat: 'beanie', extra: 'scarf', clothes: 'purple' }, emoji: '✈️' },
  { name: 'Money', role: 'Watches bills and subscriptions', look: { creature: 'bug', color: 'lemon', hat: 'top', extra: 'bowtie', clothes: 'charcoal' }, emoji: '💰' },
  { name: 'Coach', role: 'Keeps the training plan honest', look: { creature: 'bunny', color: 'berry', hat: 'headband', extra: 'none', clothes: 'teal' }, emoji: '🏃' },
  { name: 'Ideas', role: 'Brainstorms, then hands off the work', look: { creature: 'blob', color: 'periwinkle', hat: 'wizard', extra: 'none', clothes: 'purple' }, emoji: '🧠' },
]
const [kumi, researcher, inbox, chef, travel, money, coach, ideas] = crew

const providers = [
  { id: 'claude-code', name: 'Claude Code', plan: 'your Claude plan' },
  { id: 'codex', name: 'Codex', plan: 'your ChatGPT plan' },
  { id: 'grok', name: 'Grok', plan: 'your Grok plan' },
  { id: 'local', detail: 'Ollama', name: 'Ollama', plan: 'free, on your computer' },
  { id: 'local', name: 'LM Studio', plan: 'free, on your computer' },
  { id: 'openai-compatible', name: 'Any OpenAI-compatible API', plan: 'OpenRouter and more' },
]

// What a bot is, around its mascot: three parts on either side.
const ICON = {
  chat: 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.4A8 8 0 1 1 21 12z',
  memory: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5',
  globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z',
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7l1-8z',
  fork: 'M6 3v4a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4V3M12 11v10',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
}
const anatomy = {
  left: [
    { icon: ICON.chat, title: 'One conversation', text: 'Everything you say lands in one place, and it can look up anything said there, however long ago.' },
    { icon: ICON.memory, title: 'A memory of its own', text: 'It writes down how you like things done, in files you can read. Every change can be undone.' },
    { icon: ICON.globe, title: 'A browser that stays signed in', text: 'Its own Chrome profile. Sign it in once, watch it work, and take control when you like.' },
  ],
  right: [
    { icon: ICON.bolt, title: 'Powers you hand out', text: `Notion, Linear, Todoist and ${superpowers.length - 3} more, switched on for one bot at a time.` },
    { icon: ICON.fork, title: 'Help with big jobs', text: 'It splits a big job between subagents that work at the same time, and brings their results together.' },
    { icon: ICON.clock, title: 'Work while you’re away', text: 'At set times, when a page changes, or when Linear calls, and it tells you what came of it.' },
  ],
}

// The call on the page, as the panel in the app shows one: the bot passes the question on and reads out what came back.
const bars = [0.35, 0.6, 0.9, 0.55, 1, 0.7, 0.4, 0.8, 0.5, 0.95, 0.65, 0.3, 0.75, 0.5, 0.85, 0.45, 0.6, 0.35]

const faq = [
  {
    q: 'Is OpenKumi ready?',
    a: 'Not yet: OpenKumi is an alpha. It is early, it changes from one version to the next, and some things will not work yet. When something goes wrong, tell us in an issue on GitHub.',
  },
  {
    q: 'Is OpenKumi free?',
    a: 'Yes. OpenKumi is open source under the MIT License. Your bots run on a subscription you already have (Claude, ChatGPT or Grok), on free local models, or on any OpenAI-compatible API you choose.',
  },
  {
    q: 'Do I need an API key?',
    a: 'No. If Claude Code, Codex or Grok is installed and signed in on the computer, OpenKumi uses it, and Settings shows what is connected. Local models through Ollama or LM Studio are found on their own. An API key only comes in if you want to use an OpenAI-compatible endpoint.',
  },
  {
    q: 'Can I talk to my bots out loud?',
    a: 'Yes, in two ways. The microphone in the message box writes down what you say, on the device itself (macOS 26 or iOS 26 and later), so no sound leaves it. And the phone button calls the bot: it talks back at once, and you can interrupt it, in a voice you pick for it by ear. The voice comes with a ChatGPT plan, through Codex, so the sound of a call goes to OpenAI, and it works for a bot on any engine.',
  },
  {
    q: 'Where does my data live?',
    a: 'On the computer that runs your bots, in plain files and a database in ~/.openkumi. There is no OpenKumi account, and none of it is kept anywhere else. What you write to a bot goes to the model provider that bot runs on, and nowhere else; on a call, your voice and the last few messages of the conversation also go to OpenAI, whose voice the call uses. OpenKumi asks before it tells its makers anything, and then only how it is used and where it breaks, never what you or your bots write.',
  },
  {
    q: 'Could a bot do something I did not want?',
    a: 'A bot has only the superpowers you switch on for it, and cannot change them or give itself more. Each superpower asks before the things you would want to approve. When a bot edits its own instructions, you see the change and can undo it. Messages between bots show in both conversations, and can be switched off.',
  },
  {
    q: 'Can a bot use my API keys and passwords?',
    a: 'Yes, without seeing them. A bot that needs a key asks for it in a card of its own, and what you type there goes straight into the bot’s vault, encrypted, and never into the conversation or to the AI service. The bot uses it by name, and OpenKumi puts it in only on the sites you allowed it for. The vault’s key is kept apart from your data: in the Mac’s keychain, in Windows’ protection for your account, or in a Linux keyring, and otherwise in a file only your account can read.',
  },
  {
    q: 'Can several people share one computer?',
    a: 'Yes. Each person gets bots, conversations, settings and paired devices of their own, apart from everyone else’s, on the same Claude, ChatGPT or Grok plan. Add someone, and pick whose bots to show, at the top of the sidebar.',
  },
  {
    q: 'What do I need to run it?',
    a: 'A Mac with Apple silicon, a Windows 10 or later PC, or Linux, with Google Chrome (each bot browses in a Chrome profile of its own), plus something for the bots to run on: Claude Code, Codex or Grok signed in, Ollama or LM Studio running, or an OpenAI-compatible API.',
  },
  {
    q: 'Can I use it from my phone or another computer?',
    a: 'Yes. Bots can run on a computer of yours that stays on, and your laptop or iPhone pairs with it using a one-time code. At home they connect directly; away from home, through an https address, on Tailscale or elsewhere.',
  },
  {
    q: 'How does it stay up to date?',
    a: 'By itself. The desktop app downloads a new version in the background and asks you to restart when it is ready. OpenKumi installed on a computer of its own fetches the new version and starts it once no bot is working. You can switch that off and update when you choose. And the app on another of your computers, such as a Mac mini nobody sits at, updates from the one you are at, in Settings › About.',
  },
]
---

<Layout>
  <!-- ---- hero -->
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="pill"><span class="alpha">Alpha</span>Open source · Runs on your computer</span>
      <h1>Your own crew<br />of AI bots.</h1>
      <p class="lede">
        OpenKumi is a desktop app for AI bots that live on your computer. Each one has a job, a memory, a browser that stays signed in and only the powers you give it. Type to them, call them, or let them work while you’re away, on the Claude, ChatGPT or Grok plan you already have.
      </p>
      <div class="ctas">
        <a class="button primary" href={DOWNLOAD_URL} data-download>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9s-2-.9-3.4-.9c-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8 2.3-1.3 3.1-2.5c1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1-2.8-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.4-.6 3.1-1.5z"></path></svg>
          <span data-download-label>Download for Mac</span>
        </a>
        <a class="button secondary" href="#film" data-play-film>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" opacity=".12"></circle><path fill="currentColor" d="M10 8.2v7.6a.6.6 0 0 0 .9.5l6-3.8a.6.6 0 0 0 0-1l-6-3.8a.6.6 0 0 0-.9.5z"></path></svg>
          Watch the film <span class="length">{FILM.length}</span>
        </a>
      </div>
      <p class="fine">Free and MIT-licensed. No API key, no account. Also for <a href="#download">Windows, Linux and iPhone</a>.</p>
    </div>
    <div class="container stage">
      <div class="lineup" aria-hidden="true">
        {[researcher, inbox, chef, travel].map((bot, i) => <Mascot id={`hero-${i}`} look={bot.look} emoji={bot.emoji} live delay={i * 0.9} class="stand" />)}
      </div>
      <Shot name="conversation" eager alt="The OpenKumi window: a sidebar of bots, each shown by its mascot's head, with Inbox marked Needs you, and the Researcher bot comparing three cities with the help of three subagents." />
    </div>
  </section>

  <!-- ---- what it runs on -->
  <section class="runs" aria-labelledby="runs-title">
    <div class="container">
      <h2 id="runs-title" class="runs-title">Runs on the plan you already pay for, or on nothing at all</h2>
      <ul class="providers">
        {
          providers.map((p) => (
            <li>
              <ProviderMark id={p.id} detail={p.detail} />
              <span>
                <strong>{p.name}</strong>
                <small>{p.plan}</small>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---- what a bot is -->
  <section id="features" class="section anatomy-section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What a bot is</span>
        <h2>Less like a chat window. More like a colleague.</h2>
        <p>Every bot is someone with a job. It keeps one conversation with you, learns how you like things done, and has a browser and tools of its own. You decide what it may do.</p>
      </div>
      <div class="anatomy">
        <ul class="parts left">
          {anatomy.left.map((part) => (
            <li>
              <span class="part-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={part.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <h3>{part.title}</h3>
              <p>{part.text}</p>
            </li>
          ))}
        </ul>
        <div class="core" aria-hidden="true">
          <div class="halo"></div>
          <Mascot id="anatomy" look={researcher.look} emoji={researcher.emoji} live class="core-mascot" />
          <span class="core-name">Researcher</span>
          <code>bots/researcher/</code>
        </div>
        <ul class="parts right">
          {anatomy.right.map((part) => (
            <li>
              <span class="part-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={part.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
              <h3>{part.title}</h3>
              <p>{part.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ---- the film -->
  <section id="film" class="film-section" aria-labelledby="film-title">
    <div class="container">
      <div class="film-head">
        <span class="eyebrow">The film</span>
        <h2 id="film-title">OpenKumi in under a minute</h2>
      </div>
      <div class="film-frame">
        <video poster={FILM.poster} controls muted playsinline preload="metadata" width="1920" height="1080" aria-label="A short film about OpenKumi, without sound: the crew of bots, a conversation with subagents, a bot browsing, a call, automations, superpowers, bots working together, the phone, and the plans it runs on.">
          <source src={FILM.webm} type='video/webm; codecs="av01.0.08M.08"' />
          <source src={FILM.mp4} type="video/mp4" />
        </video>
      </div>
      <p class="fine center">No sound needed: everything is on screen.</p>
    </div>
  </section>

  <!-- ---- talking to it -->
  <section id="talk" class="section">
    <div class="container">
      <div class="chapter-head">
        <span class="eyebrow">Talking to it</span>
        <h2>Type it, say it, or call it.</h2>
        <p>Write while it works, and your message waits in view. Speak, and the words are written down on your own device. Or press the phone button and just talk.</p>
      </div>
      <div class="talk">
        <article class="tile call-tile">
          <div class="call" aria-hidden="true">
            <div class="call-top"><span class="rec"></span>On a call with Kumi<span class="call-time">01:24</span></div>
            <Mascot id="call" live class="call-mascot" />
            <div class="bars">{bars.map((h, i) => <span style={`--h: ${h}; --i: ${i}`}></span>)}</div>
            <div class="said">
              <p class="you">Is anything in my inbox urgent?</p>
              <p class="bot">I asked Inbox. Two things: the landlord wants a time for the repair, and your flight moved to 9:40.</p>
            </div>
            <div class="call-buttons"><span>Mute</span><span class="hang">Hang up</span></div>
          </div>
          <div class="tile-copy">
            <span class="eyebrow">New</span>
            <h3>Call your bot</h3>
            <p>Press the phone button and talk. It answers out loud, at once, and you can cut in as you would with a person. What needs work goes to the bot, or to another bot, and what comes back is read out.</p>
            <ul class="checks">
              <li>The voice comes with your ChatGPT plan, through Codex. No API key, and it works for a bot on any engine.</li>
              <li>Your voice, and the last few messages of the conversation, go to OpenAI for the call. Dictation stays on the device.</li>
              <li>On the computer and the iPhone. The call goes on while you look at something else.</li>
              <li>Each bot speaks in a voice you choose for it by ear.</li>
              <li>What was asked and said is kept in the conversation.</li>
            </ul>
          </div>
        </article>
        <article class="tile">
          <div class="compose" aria-hidden="true">
            <span class="typed">Find us a quiet table for two on Friday<i class="caret"></i></span>
            <span class="mic"><svg viewBox="0 0 24 24"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zM19 11a7 7 0 0 1-14 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></span>
          </div>
          <div class="tile-copy">
            <h3>Dictate</h3>
            <p>The microphone writes what you say into the message as you say it. It is written down on the device itself, with Apple’s speech models, so no sound leaves it.</p>
          </div>
        </article>
        <article class="tile">
          <div class="queue" aria-hidden="true">
            <span class="queued">Also check what Porto costs<span class="send-now">Send now</span></span>
            <span class="working"><span class="spin"></span>Researcher is working…</span>
          </div>
          <div class="tile-copy">
            <h3>Say more while it works</h3>
            <p>A message to a busy bot waits in view, to be read in turn. Take it back, or press Send now and the bot reads it as it works, and changes course.</p>
          </div>
        </article>
        <article class="tile">
          <div class="files-art" aria-hidden="true">
            <span class="file"><svg viewBox="0 0 24 24"><path d="M14 3H6v18h12V7zM14 3v4h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>lease-2026.pdf</span>
            <span class="arrow">→</span>
            <code>files/inbox/</code>
          </div>
          <div class="tile-copy">
            <h3>Send it files</h3>
            <p>Drop or paste files into a message. The bot gets a copy of its own to read, keep, or file away with the rest of its work.</p>
          </div>
        </article>
      </div>
      <div class="replies">
        <span class="part-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-4.6-4.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        <p><strong>Find anything with <kbd>⌘K</kbd>.</strong> A bot, a setting, or something said in any conversation, from anywhere in the desktop app. <kbd>⌘1</kbd>–<kbd>9</kbd> opens one of your first nine bots. On Windows and Linux, it is Ctrl.</p>
      </div>
    </div>
  </section>

  <!-- ---- the work -->
  <section id="work" class="section band">
    <div class="container">
      <div class="chapter-head">
        <span class="eyebrow">The work</span>
        <h2>It does the work, where you can see it.</h2>
        <p>Not just answers: it opens pages, signs in, splits up big jobs and keeps notes. Every step shows in the conversation.</p>
      </div>

      <div class="feature wide">
        <div class="copy">
          <h3>A browser of its own, already signed in</h3>
          <p>Every bot gets its own Chrome profile. Sign in to a site once and that bot stays signed in, with nothing shared between bots or with your own browser. A small live view floats over the chat while it browses. Take control whenever you like, from the computer or the phone, and hand it back when you are done. If it meets a sign-in page or a CAPTCHA, it asks you and waits.</p>
        </div>
        <Shot name="browser" crop={{ x: 0.325, y: 0.39, w: 0.665, h: 0.5 }} sizes="(max-width: 860px) 151vw, 1060px" alt="The Travel bot reading a travel guide about Lisbon, with a small live view of its browser floating in the corner of the window." />
      </div>

      <div class="feature flip">
        <div class="copy">
          <h3>Big jobs, split into subagents</h3>
          <p>A bot can hand parts of a task to subagents that work at the same time, each in its own thread. Watch them live, open one to read or nudge it, or stop it. When they finish, the results flow back to the bot that asked.</p>
        </div>
        <div class="art subagents-art" aria-hidden="true">
          <div class="task">Compare three standing desks under €600</div>
          {
            [
              ['Read reviews of the Flexispot E7', 'done', 'Finished · 41s'],
              ['Check prices and delivery in Portugal', 'done', 'Finished · 1m 12s'],
              ['Look for known problems on forums', 'run', 'Reading 4 of 9 threads'],
            ].map(([title, state, note]) => (
              <div class:list={['sub', state]}>
                <span class="state" />
                <span>
                  <strong>{title}</strong>
                  <small>{note}</small>
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="feature">
        <div class="copy">
          <h3>It learns how you like things done, in the open</h3>
          <p>Each bot keeps its own instructions and a memory folder, and rewrites them as it learns how you want it to work. Every change it makes to itself is recorded and shown to you, and any of them can be undone.</p>
        </div>
        <div class="art diff-art" aria-hidden="true">
          <div class="diff-head"><Mascot id="diff" look={researcher.look} emoji={researcher.emoji} crop="fit" class="head" /><span><strong>Researcher</strong> updated <code>AGENTS.md</code></span><span class="undo">Undo</span></div>
          <pre><span class="ctx">## How to answer</span>
<span class="add">+ Lead with the recommendation, then the table.</span>
<span class="add">+ Prices in euros, delivery to Portugal.</span>
<span class="del">- Give a detailed summary of every source.</span>
<span class="add">+ Link sources at the end, at most five.</span></pre>
        </div>
      </div>

      <div class="replies">
        <span class="part-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 15l4-4 3 3 5-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        <p><strong>Answers you can look at.</strong> Code in colour, tables, diagrams and formulas. A bot can also show a whole page in the conversation: a chart, a dashboard, a timeline.</p>
      </div>
    </div>
  </section>

  <!-- ---- automations -->
  <section id="automations" class="section">
    <div class="container split wide">
      <div class="copy">
        <span class="eyebrow">While you’re away</span>
        <h2>It works without being asked.</h2>
        <p>An automation gives a bot a job of its own. It runs in the background and the bot tells you, in its conversation, what came of it.</p>
        <ul class="triggers">
          <li>
            <span class="trigger-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.clock} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <span><strong>At set times</strong>Every weekday at 7:30, every Sunday evening, or once next Friday.</span>
          </li>
          <li>
            <span class="trigger-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <span><strong>When something changes</strong>OpenKumi looks at a page or one of the bot’s apps at no cost, and starts the bot only when it has changed.</span>
          </li>
          <li>
            <span class="trigger-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <span><strong>When an app calls</strong>Linear calls the bot’s webhook when something happens there, and the bot starts on it. Calls that come close together are answered together.</span>
          </li>
        </ul>
        <p class="note">Each automation runs on its bot’s model, or on one of its own, such as a lighter one for a simple check.</p>
      </div>
      <Shot name="tasks" crop={{ x: 0.345, y: 0.19, w: 0.49, h: 0.49 }} sizes="(max-width: 860px) 204vw, 1310px" alt="OpenKumi's automations: a weekday morning briefing, a weekly dinner plan, a watch on OpenKumi's releases page, and new Linear issues to sort as they come in." />
    </div>

    <div class="container split wide flip asks-row">
      <div class="copy">
        <span class="eyebrow">When it needs you</span>
