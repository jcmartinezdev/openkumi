<script is:inline define:vars={{ downloads: DOWNLOADS }}>
  // The main buttons give a Mac's installer, which is what most visitors need. On Windows or
  // Linux they give that system's instead, and its card in the list is marked as the visitor's.
  const agent = navigator.userAgent
  const phone = /Android|iPhone|iPad|iPod/.test(agent)
  const mine = phone ? null : /Windows/.test(agent) ? 'windows' : /Linux|X11|CrOS/.test(agent) ? 'linux' : 'mac'
  const system = downloads.find((item) => item.id === mine)
  if (system && mine !== 'mac') {
    for (const button of document.querySelectorAll('[data-download]')) {
      button.href = system.files[0].href
      button.querySelector('[data-download-label]').textContent = `Download for ${system.name}`
      button.querySelector('svg')?.remove()
    }
  }
  if (system) document.querySelector(`[data-system="${mine}"]`)?.classList.add('yours')
  // On an iPhone, the app for it is what the visitor can get from here.
  if (/iPhone|iPod/.test(agent)) document.querySelector('[data-system="iphone"]')?.classList.add('yours')

  for (const button of document.querySelectorAll('[data-copy]')) {
    button.addEventListener('click', async () => {
      const copied = await navigator.clipboard.writeText(button.dataset.copy).then(() => true, () => false)
      // Where the page may not write to the clipboard, the line is selected, ready to be copied by hand.
      if (!copied) getSelection()?.selectAllChildren(button.parentElement.querySelector('code'))
      button.textContent = copied ? 'Copied' : 'Selected'
      setTimeout(() => (button.textContent = 'Copy'), 1600)
    })
  }

  // "Watch the film" goes to the film and starts it; without the script, the link still goes there.
  const film = document.querySelector('#film video')
  for (const link of document.querySelectorAll('[data-play-film]')) {
    link.addEventListener('click', (event) => {
      if (!film) return
      event.preventDefault()
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches
      document.querySelector('#film').scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' })
      // The keyboard goes with the eye, to the player's controls.
      film.focus({ preventScroll: true })
      film.play().catch(() => {})
    })
  }
</script>

