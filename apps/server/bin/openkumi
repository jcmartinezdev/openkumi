#!/bin/sh
# The openkumi command of a server installed on its own (openkumi.ai/install.sh). It sits in a
# version's folder, beside the Node that version runs with:
#   <runtime>/versions/<version>/bin/openkumi    this file
#   <runtime>/versions/<version>/node
#   <runtime>/versions/<version>/server/
#   <runtime>/current                            a link to the version that is started
# It is always run through "current", so after an update it is the new version's.
set -e
here=$(cd "$(dirname "$0")/.." && pwd -P)
OPENKUMI_RUNTIME=${OPENKUMI_RUNTIME:-$(dirname "$(dirname "$here")")}
export OPENKUMI_RUNTIME

case "${1:-}" in
  serve)
    # What the background service runs: the server itself and nothing around it, so that it is
    # the one told to stop. When it stops to update, the service starts it again. What follows
    # is passed on: "--for <name>" makes it the server of someone else on this computer.
    shift
    exec "$here/node" "$here/server/src/index.ts" "$@"
    ;;
esac
# Everything else, "start" among it: in a terminal, the servers of everyone here, each started
# again when it stops to update (src/start.ts).
exec "$here/node" "$here/server/src/cli.ts" "$@"
