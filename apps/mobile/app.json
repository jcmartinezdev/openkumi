{
  "expo": {
    "name": "Open Bot",
    "slug": "open-bot",
    "scheme": "openbot",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.jcmartinez.openbot",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Open Bot connects to the computer on your network that runs your bots.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "48U5Q483NS"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Open Bot uses the camera to scan the pairing code shown on your computer.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
